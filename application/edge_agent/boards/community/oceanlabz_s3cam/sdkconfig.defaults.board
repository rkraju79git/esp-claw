CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# N16R8: octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console over the native USB (USB-Serial-JTAG) port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# OV3660 camera over DVP (SCCB 0x3C). YUV422 is the build-safe default format;
# the /hwtest camera capture serves a grayscale preview from the Y plane, so no
# on-device JPEG encoder is required.
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3660_DVP_YUV422_YUYV_640X480_10FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_YUV422_YUYV_640X480_10FPS=y
CONFIG_APP_CLAW_LUA_MODULE_CAMERA=y

# Voice channel enabled, relocated to camera-safe pins (Mode B).
# Set your OpenAI API key with `idf.py menuconfig` before flashing.
CONFIG_APP_CLAW_CAP_IM_VOICE=y
CONFIG_CAP_IM_VOICE_MIC_BCLK_GPIO=38
CONFIG_CAP_IM_VOICE_MIC_WS_GPIO=39
CONFIG_CAP_IM_VOICE_MIC_SD_GPIO=40
CONFIG_CAP_IM_VOICE_SPK_BCLK_GPIO=41
CONFIG_CAP_IM_VOICE_SPK_LRC_GPIO=42
CONFIG_CAP_IM_VOICE_SPK_DIN_GPIO=2
